---
/**
 * One paper building in the town: a box of CSS 3D faces (south wall, east
 * wall, roof; the other two are never seen from the camera), each face a
 * small SVG drawing in the page's ink. The walls lie flat on the footprint
 * and swing up (--p 0 → 1, driven by scroll in animations.ts) like a pop-up
 * book; the roof rises with them. Over the roof float billboards that always
 * face the camera: the label, the active pin, and the building's one small
 * piece of life (a chat bubble, an envelope, a sun) that plays on hover.
 * The roof is the real button; the rest is decoration.
 */
import type { Building } from '../data/town';

interface Props {
  b: Building;
  name: string;
}
const { b, name } = Astro.props;
const { w, d, h, kind } = b;

const win = (x: number, y: number, ww: number, wh: number, k = 0, cls = 'win') =>
  `<rect class="${cls}" x="${x}" y="${y}" width="${ww}" height="${wh}" rx="1.5" style="--k:${k}"/>`;
/** a grid of windows across a face */
const windows = (W: number, cols: number, rows: number, top: number, bottom: number, ww: number, wh: number, side = 8) => {
  const gx = cols > 1 ? (W - 2 * side - cols * ww) / (cols - 1) : 0;
  const gy = rows > 1 ? (bottom - top - rows * wh) / (rows - 1) : 0;
  let s = '';
  for (let r = rows - 1; r >= 0; r--)
    for (let c = 0; c < cols; c++) s += win(side + c * (ww + gx), top + r * (wh + gy), ww, wh, rows - 1 - r);
  return s;
};
const wall = (W: number, H: number, hatch = false) =>
  `<rect class="wall" x="0" y="0" width="${W}" height="${H}"/>` + (hatch ? `<rect class="hatch" x="0" y="0" width="${W}" height="${H}"/>` : '');
const door = (x: number, y: number, ww: number, wh: number, cls = 'door') =>
  `<rect class="${cls}" x="${x}" y="${y}" width="${ww}" height="${wh}" rx="1"/><circle class="knob" cx="${x + ww - 3.5}" cy="${y + wh / 2}" r="1"/>`;
const arch = (x: number, y: number, ww: number, wh: number, cls = 'win') =>
  `<path class="${cls}" d="M${x} ${y + wh} V${y + ww / 2} a${ww / 2} ${ww / 2} 0 0 1 ${ww} 0 V${y + wh} Z"/>`;

let south = '';
let east = '';
let roof = '';
let life = '';

switch (kind) {
  case 'tower':
    south =
      wall(w, h) +
      `<text class="sign-text" x="${w / 2}" y="15" text-anchor="middle">KBZ</text>` +
      windows(w, 4, 7, 24, 150, 14, 11) +
      `<rect class="col" x="${w / 2 - 30}" y="${h - 36}" width="4" height="36"/><rect class="col" x="${w / 2 + 26}" y="${h - 36}" width="4" height="36"/>` +
      `<path class="line" d="M${w / 2 - 34} ${h - 37} H${w / 2 + 34}"/>` +
      `<rect class="door glass" x="${w / 2 - 16}" y="${h - 32}" width="32" height="32"/><path class="line" d="M${w / 2} ${h - 32} V${h}"/>`;
    east = wall(d, h, true) + windows(d, 3, 7, 24, 150, 12, 11);
    roof =
      `<rect class="box" x="${w / 2 - 16}" y="${d / 2 - 12}" width="32" height="22"/>` +
      `<circle class="line" cx="${w / 2 + 32}" cy="${d / 2 + 22}" r="10"/><text class="sign-text" x="${w / 2 + 32}" y="${d / 2 + 26.5}" text-anchor="middle" font-size="12">H</text>`;
    life = `<div class="bb bb-chat" style="--z:34px"><div class="bb-in"><svg viewBox="0 0 64 44"><path class="bubble" d="M8 4 C28 2, 46 2, 58 5 C62 6, 62 10, 61 14 L60 28 C60 32, 57 34, 53 34 L26 35 L14 42 L16 35 C9 35, 5 32, 5 28 L5 10 C5 6, 6 4, 8 4 Z"/><circle class="dot" cx="22" cy="19" r="3.2"/><circle class="dot" cx="33" cy="19" r="3.2"/><circle class="dot" cx="44" cy="19" r="3.2"/></svg></div></div>`;
    break;
  case 'clinic':
    south =
      wall(w, h) +
      windows(w, 5, 1, 10, 24, 16, 14) +
      `<circle class="badge" cx="${w / 2}" cy="35" r="6.5"/><path class="plus" d="M${w / 2 - 3.5} 35 h7 M${w / 2} 31.5 v7"/>` +
      `<rect class="door glass" x="${w / 2 - 15}" y="${h - 34}" width="30" height="34" rx="1"/><path class="line" d="M${w / 2} ${h - 34} V${h}"/>`;
    east = wall(d, h, true) + windows(d, 3, 1, 10, 24, 16, 14);
    roof = `<circle class="badge" cx="${w / 2}" cy="${d / 2}" r="22"/><path class="plus plus-big" d="M${w / 2 - 12} ${d / 2} h24 M${w / 2} ${d / 2 - 12} v24"/>`;
    life = `<div class="life-car ambulance" style="left:${w + 24}px;top:4px"><svg viewBox="0 0 36 18"><rect class="car-body" x="1" y="2" width="34" height="14" rx="3"/><rect class="car-top" x="18" y="4" width="12" height="10" rx="2"/><path class="plus" d="M10 9 h6 M13 6 v6"/><rect class="beacon" x="22" y="7" width="4" height="4" rx="1"/></svg></div>`;
    break;
  case 'salon':
    south =
      wall(w, h) +
      `<path class="sparkle" d="M50 4 l2.2 5.6 5.6 2.2 -5.6 2.2 -2.2 5.6 -2.2 -5.6 -5.6 -2.2 5.6 -2.2 Z"/>` +
      Array.from({ length: 10 }, (_, i) => `<rect class="${i % 2 ? 'stripe' : 'stripe-alt'}" x="${i * 10}" y="24" width="10" height="11"/>`).join('') +
      `<path class="line" d="M0 35 H${w}"/>` +
      `<rect class="win big" x="8" y="40" width="52" height="28" rx="1.5"/><path class="line thin" d="M34 40 V68"/>` +
      door(70, 41, 20, 34, 'door swing');
    east = wall(d, h, true) + win(12, 40, 22, 24) + win(46, 40, 22, 24, 1);
    roof = `<path class="sparkle" d="M${w / 2} ${d / 2 - 14} l4 10 10 4 -10 4 -4 10 -4 -10 -10 -4 10 -4 Z"/>`;
    life = `<div class="bb bb-sparkles" style="--z:30px"><div class="bb-in"><svg viewBox="0 0 60 40"><path class="sparkle s1" d="M14 20 l2.5 6.5 6.5 2.5 -6.5 2.5 -2.5 6.5 -2.5 -6.5 -6.5 -2.5 6.5 -2.5 Z"/><path class="sparkle s2" d="M34 6 l3 8 8 3 -8 3 -3 8 -3 -8 -8 -3 8 -3 Z"/><path class="sparkle s3" d="M48 26 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2 Z"/></svg></div></div>`;
    break;
  case 'houses':
    // three small houses along y, drawn by the component's own markup below
    life = `<div class="bb bb-sign" style="--z:36px;--by:22px"><div class="bb-in"><svg viewBox="0 0 70 44"><path class="post" d="M35 44 V14"/><path class="board" d="M6 4 C24 2, 46 2, 64 4 C66 4, 67 6, 67 8 L66 26 C46 28, 24 28, 6 26 C4 26, 3 24, 3 22 L4 8 C4 6, 5 4, 6 4 Z"/><text class="sign-text" x="35" y="19" text-anchor="middle" font-size="11">for rent</text></svg></div></div>`;
    break;
  case 'lab':
    south =
      wall(w, h) +
      windows(w, 3, 1, 10, 26, 16, 16) +
      door(w / 2 - 10, h - 30, 20, 30) +
      `<rect class="board" x="62" y="34" width="32" height="28" rx="1"/>` +
      `<rect class="bar" x="66" y="40" width="5" height="18" style="--k:0"/><rect class="bar" x="73" y="40" width="5" height="18" style="--k:1"/><rect class="bar" x="80" y="40" width="5" height="18" style="--k:2"/><rect class="bar" x="87" y="40" width="5" height="18" style="--k:3"/>`;
    east = wall(d, h, true) + windows(d, 3, 1, 10, 26, 16, 16);
    roof = `<rect class="box" x="12" y="12" width="18" height="12"/><rect class="box" x="36" y="12" width="18" height="12"/>`;
    break;
  case 'pavilion':
    south =
      wall(w, h) +
      `<polyline class="pulse" points="20,14 32,14 36,7 41,21 46,10 49,14 70,14"/>` +
      arch(10, 26, 16, 30) +
      arch(64, 26, 16, 30) +
      arch(w / 2 - 10, h - 32, 20, 32, 'door glass arch');
    east = wall(d, h, true) + arch(26, 26, 18, 30);
    roof = `<circle class="line" cx="${w / 2}" cy="${d / 2}" r="14"/><circle class="line thin" cx="${w / 2}" cy="${d / 2}" r="8"/>`;
    break;
  case 'office':
    south = wall(w, h) + windows(w, 3, 5, 12, 74, 14, 9) + door(w / 2 - 9, h - 24, 18, 24);
    east = wall(d, h, true) + windows(d, 2, 5, 12, 74, 14, 9);
    roof = `<rect class="box" x="${w - 26}" y="12" width="14" height="14"/>`;
    life = `<div class="bb bb-mail" style="--z:18px;--bx:${w - 19}px;--by:19px"><div class="bb-in"><svg viewBox="0 0 40 28"><path class="mail" d="M4 5 C16 4, 24 4, 36 5 L36 23 C24 24, 16 24, 4 23 Z"/><path class="line" d="M4 6 L20 16 L36 6"/></svg></div></div>`;
    break;
  case 'hall':
    south = wall(w, h) + windows(w, 6, 1, 12, 28, 13, 14) + door(w / 2 - 12, h - 28, 24, 28, 'door glass') + `<path class="line" d="M${w / 2} ${h - 28} V${h}"/>`;
    east = wall(d, h, true) + windows(d, 3, 1, 12, 28, 14, 14);
    roof = Array.from({ length: 8 }, (_, i) => `<rect class="panel" x="${12 + (i % 4) * 25}" y="${14 + Math.floor(i / 4) * 28}" width="20" height="22"/>`).join('');
    life = `<div class="bb bb-sun" style="--z:10px;--by:-6px"><div class="bb-in"><svg viewBox="0 0 60 60"><circle class="sun" cx="30" cy="30" r="12"/><path class="rays" d="M30 6 V14 M30 46 V54 M6 30 H14 M46 30 H54 M13 13 L19 19 M41 41 L47 47 M47 13 L41 19 M19 41 L13 47"/></svg></div></div>`;
    break;
  case 'gallery':
    south =
      wall(w, h) +
      `<rect class="win big" x="10" y="16" width="70" height="40" rx="1.5"/>` +
      `<rect class="pic pic1" x="16" y="24" width="16" height="20"/><rect class="pic pic2" x="37" y="22" width="18" height="24"/><rect class="pic pic3" x="60" y="26" width="14" height="18"/>` +
      door(88, 30, 16, 35);
    east = wall(d, h, true) + win(20, 20, 30, 22);
    roof = Array.from({ length: 6 }, (_, i) => `<rect class="panel" x="${14 + (i % 3) * 30}" y="${12 + Math.floor(i / 3) * 26}" width="22" height="20"/>`).join('');
    life = `<div class="bb bb-banner" style="--z:30px"><div class="bb-in"><svg viewBox="0 0 80 40"><path class="post" d="M8 40 V4 M72 40 V4"/><path class="banner" d="M8 6 C30 4, 50 4, 72 6 L72 26 C50 28, 30 28, 8 26 Z"/><text class="sign-text" x="40" y="20" text-anchor="middle" font-size="11">new show</text></svg></div></div>`;
    break;
  case 'kiosk':
    south = wall(w, h) + `<rect class="screen" x="12" y="10" width="36" height="20" rx="1.5"/><path class="line thin paper" d="M18 17 H42 M18 23 H34"/>` + door(20, h - 24, 20, 24);
    east = wall(d, h, true) + win(16, 12, 18, 14);
    roof = `<circle class="line" cx="${w / 2}" cy="${d / 2}" r="8"/>`;
    life = `<div class="bb bb-coin" style="--z:30px"><div class="bb-in"><svg viewBox="0 0 40 40"><circle class="coin" cx="20" cy="20" r="16"/><text class="sign-text coin-text" x="20" y="25.5" text-anchor="middle" font-size="15">M</text></svg></div></div>`;
    break;
}

const houseW = 46;
const houseD = 40;
const houseH = 34;
const rise = 16;
const slope = Math.hypot(houseD / 2, rise);
const slopeAngle = (Math.atan2(rise, houseD / 2) * 180) / Math.PI;
const houseSouth = wall(houseW, houseH) + door(28, 14, 12, 20) + win(7, 11, 13, 11);
const houseEast = `<path class="wall" d="M0 ${rise} L${houseD / 2} 0 L${houseD} ${rise} V${houseH + rise} H0 Z"/><path class="hatch" d="M0 ${rise} L${houseD / 2} 0 L${houseD} ${rise} V${houseH + rise} H0 Z"/>` + win(13, rise + 10, 14, 12);
const houseRoof = `<rect class="roofing" x="0" y="0" width="${houseW}" height="${slope}"/>` + Array.from({ length: 4 }, (_, i) => `<path class="line thin" d="M0 ${5 + i * 6} H${houseW}"/>`).join('');
---

<li class={`bld bld-${kind}`} style={`--x:${b.x}px;--y:${b.y}px;--w:${w}px;--d:${d}px;--h:${h}px`} data-bld={b.key}>
  {
    kind === 'houses' ? (
      <>
        {[0, 1, 2].map((i) => (
          <div
            class="house"
            style={`--w:${houseW}px;--d:${houseD}px;--h:${houseH}px;--r:${rise}px;--s:${slope.toFixed(2)}px;--ra:${slopeAngle.toFixed(2)}deg;--hy:${i * (houseD + 15)}px`}
            aria-hidden={i === 1 ? undefined : 'true'}
          >
            <div class="face wall-s" aria-hidden="true"><svg class="art" viewBox={`0 0 ${houseW} ${houseH}`} set:html={houseSouth} /></div>
            <div class="face wall-e" aria-hidden="true"><svg class="art" viewBox={`0 0 ${houseD} ${houseH + rise}`} set:html={houseEast} /></div>
            <div class="face roof-s" aria-hidden="true"><svg class="art" viewBox={`0 0 ${houseW} ${slope}`} set:html={houseRoof} /></div>
            <div class="face roof-n" aria-hidden="true"><svg class="art" viewBox={`0 0 ${houseW} ${slope}`} set:html={houseRoof} /></div>
            {i === 1 ? (
              <button type="button" class="face roof bld-hit" aria-label={name} aria-pressed="false" />
            ) : (
              <div class="face roof" aria-hidden="true" />
            )}
          </div>
        ))}
      </>
    ) : (
      <>
        <div class="face wall-s" aria-hidden="true"><svg class="art" viewBox={`0 0 ${w} ${h}`} set:html={south} /></div>
        <div class="face wall-e" aria-hidden="true"><svg class="art" viewBox={`0 0 ${d} ${h}`} set:html={east} /></div>
        <button type="button" class="face roof bld-hit" aria-label={name} aria-pressed="false">
          <svg class="art" viewBox={`0 0 ${w} ${d}`} aria-hidden="true" set:html={`<rect class="roofing" x="0" y="0" width="${w}" height="${d}"/>` + roof} />
        </button>
      </>
    )
  }
  <div class="bld-label" aria-hidden="true" style={kind === 'houses' ? '--by:75px' : undefined}>
    <span class="bld-tag hand">{b.label}</span>
  </div>
  <div class="bb bld-pin" aria-hidden="true" style={kind === 'houses' ? '--z:62px;--by:75px' : '--z:60px'}>
    <div class="bb-in"><span class="bld-pin-dot"></span></div>
  </div>
  <Fragment set:html={life} />
</li>
