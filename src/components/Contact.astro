---
import { profile } from '../data/resume';
import HandArrow from './HandArrow.astro';
---

<section class="mx-auto max-w-6xl px-6 pt-12 lg:pt-16" aria-labelledby="contact">
  <!-- the card is a letter: an airmail edge along the top, a postmark, the envelope the plane lands as -->
  <div class="contact-card relative" data-tilt="1" data-lift="2">
    <div class="pointer-events-none absolute -top-14 left-6 hidden sm:block">
      <p class="hand -rotate-3 text-2xl text-accent">let’s build something</p>
      <HandArrow variant="down" class="ml-24 h-10 w-6 text-accent" />
    </div>
    <svg class="postmark" viewBox="0 0 160 110" aria-hidden="true">
      <circle class="postmark-ring" cx="52" cy="55" r="40" />
      <circle class="postmark-ring thin" cx="52" cy="55" r="31" />
      <text class="postmark-text" x="52" y="50" text-anchor="middle">BANGKOK</text>
      <text class="postmark-text" x="52" y="66" text-anchor="middle">AIR MAIL</text>
      <path class="postmark-wave" d="M98 38 C110 32, 122 44, 134 38 S152 32, 158 38 M98 55 C110 49, 122 61, 134 55 S152 49, 158 55 M98 72 C110 66, 122 78, 134 72 S152 66, 158 72" />
    </svg>

    <!-- the paper plane lands here and unfolds into the envelope (MorphSVG, in
         animations.ts). The resting shapes in the markup are the envelope, so
         no-JS and reduced-motion visitors see the letter, not a plane. -->
    <div id="contact-envelope" class="pointer-events-none absolute right-8 top-8 hidden sm:block">
      <svg
        id="contact-plane"
        class="w-32 text-ink-soft"
        viewBox="0 0 140 100"
        fill="none"
        aria-hidden="true"
        data-plane="M8 50 C40 38, 76 24, 108 12 C94 36, 82 60, 68 84 C62 74, 58 66, 52 56 C38 54, 22 52, 8 50 Z"
        data-plane-fold="M52 56 C70 42, 90 26, 108 12"
      >
        <path id="morph-body" class="draw-path" stroke-width="3" d="M13 20 C55 15, 90 15, 127 20 C130 45, 130 65, 127 84 C85 89, 50 89, 15 84 C11 62, 11 41, 13 20 Z" />
        <path id="morph-fold" class="draw-path" stroke-width="3" d="M15 22 C35 42, 55 56, 70 56 C85 56, 107 40, 125 22" />
      </svg>
    </div>

    <h2 id="contact" class="hand text-3xl font-bold sm:text-4xl">
      <span data-annotate="underline">Get in touch</span>
    </h2>
    <p class="mt-4 max-w-xl text-lg text-ink">
      Available for consulting work, and open to the right full-time role. Either way, email is the
      fastest way to reach me, and I actually reply.
    </p>
    <p class="hand mt-3 text-lg text-accent">
      I’m in Thailand (UTC+7) and usually reply the same day.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-4">
      <span class="relative inline-block">
        <!-- text is written by animations.ts on click so the live region
             actually announces; a permanently-present string would not -->
        <span
          id="email-copied"
          role="status"
          class="hand pointer-events-none invisible absolute -top-7 left-1/2 -translate-x-1/2 whitespace-nowrap text-lg text-accent opacity-0"
        />
        <a
          id="email-btn"
          href={`mailto:${profile.email}`}
          data-email={profile.email}
          title="Opens your mail app, and copies the address"
          class="button-primary"
        >
          {profile.email}
        </a>
      </span>
      <a href={profile.cvFile} download class="button-secondary">Download CV</a>
    </div>

    <ul class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2 text-ink">
      <li>
        <a href={profile.github} target="_blank" rel="noopener noreferrer" class="chip contact-pill">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" /></svg>
          GitHub
        </a>
      </li>
      <li>
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="chip contact-pill">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6ZM2 9h4v12H2z" /><circle cx="4" cy="4" r="2" /></svg>
          LinkedIn
        </a>
      </li>
      <li class="flex flex-wrap items-center gap-1.5">
        <a href={`tel:${profile.phone}`} class="chip contact-pill">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
          {profile.phone}
        </a>
        <HandArrow variant="curve-left" class="h-4 w-8 shrink-0 text-accent" />
        <a
          href={`https://wa.me/${profile.phone.replace(/[^0-9]/g, '')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="hand whitespace-nowrap text-lg text-accent underline-offset-4 hover:underline"
        >
          also on WhatsApp!
        </a>
      </li>
    </ul>
  </div>
</section>
