---
/**
 * About, as a departures board. The summary stands as a paragraph that inks
 * in as it is read; the six highlights are rows of split-flap cells (cream
 * flaps, ink letters) that flip into place when the board arrives (board.ts),
 * flip a row's status to BOARDING when it is hovered, focused or pressed,
 * and walk to the next row on their own while nobody is looking. The chosen
 * row's full sentence reads below the board, with a gate to the project it
 * belongs to in the town. Every cell carries its final letter in the markup,
 * so the board reads without JS; the plain list under it shows then too.
 */
import { profile, highlights } from '../data/resume';
import { buildings } from '../data/town';
import SectionHeading from './SectionHeading.astro';

/** column widths in characters; the flaps pad to these */
const columns: { key: 'time' | 'to' | 'flight' | 'remarks' | 'status'; label: string; width: number }[] = [
  { key: 'time', label: 'Time', width: 7 },
  { key: 'to', label: 'Destination', width: 20 },
  { key: 'flight', label: 'Flight', width: 6 },
  { key: 'remarks', label: 'Remarks', width: 16 },
  { key: 'status', label: 'Status', width: 8 },
];
const cells = (text: string, width: number) => Array.from(text.toUpperCase().padEnd(width).slice(0, width));
/** one split flap: two static halves and the flipper, every face showing ch */
const flap = (ch: string) =>
  `<span class="flap" data-char="${ch}"><span class="flap-top">${ch}</span><span class="flap-bottom">${ch}</span><span class="flap-flip"><span class="flap-flip-front">${ch}</span><span class="flap-flip-back">${ch}</span></span></span>`;
const flaps = (text: string, width: number) => cells(text, width).map(flap).join('');
const labelFor = (key?: string) => buildings.find((b) => b.key === key)?.label;
const first = highlights[0];
---

<section id="content" tabindex="-1" class="relative mx-auto max-w-6xl px-6 py-20 lg:py-28" aria-labelledby="about">
  <SectionHeading id="about" label="About" aside="departures" />

  <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
    <p class="about-statement max-w-2xl text-xl leading-relaxed text-ink sm:text-2xl" data-fill>{profile.summary}</p>
    <div class="board-side">
      <!-- the clock on the board: Bangkok's time, flipped by board.ts (hidden without it) -->
      <div class="board-clock" data-board-clock>
        <span class="board-clock-flaps" aria-hidden="true" set:html={flaps('--:--', 5)} />
        <p class="board-clock-label">
          <span class="sr-only" data-board-clock-sr></span>
          Bangkok · local time<span data-board-clock-vs></span>
        </p>
      </div>
      <p class="hand text-lg text-ink-soft">six things I’d tell you first, as they come up on the board</p>
      <p class="hand mt-1 text-lg text-accent">hover a row · press one to read it</p>
    </div>
  </div>

  <div class="board" data-board>
    <div class="board-frame">
      <div class="board-head" aria-hidden="true">
        {columns.map((c) => <span class={`board-col board-col-${c.key}`}>{c.label}</span>)}
      </div>
      <ol class="board-rows">
        {
          highlights.map((h, i) => (
            <li>
              <button
                type="button"
                class="board-row"
                data-row={i}
                data-status={h.board.status}
                data-project={h.board.project}
                aria-label={`${h.board.remarks.toLowerCase()}: ${h.text}`}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                <span class="board-dot" aria-hidden="true"></span>
                {columns.map((c) => (
                  <span class={`board-col board-col-${c.key}`} aria-hidden="true" data-col={c.key} set:html={flaps(h.board[c.key], c.width)} />
                ))}
              </button>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- the chosen row, in full -->
    <div class="board-detail" aria-live="polite">
      <p class="board-detail-status"> <!-- taste-skill-ignore: a departure board's announcement line, not a kicker -->
        <span class="board-detail-blink" aria-hidden="true"></span>
        Now boarding · <span data-detail-flight>{first.board.flight}</span>
      </p>
      <p class="board-detail-text" data-detail-text>{first.text}</p>
      <p class="board-detail-foot">
        <span class="hand text-accent" data-detail-note>{first.note}</span>
        <a class="board-gate text-link" href="#projects" data-detail-gate data-project={first.board.project} hidden={!first.board.project}>
          gate: <span data-detail-gate-label>{labelFor(first.board.project)}</span> <span class="arrow">→</span>
        </a>
      </p>
    </div>

    <!-- without JS the board stands still; the six lines read here instead -->
    <ul class="board-fallback">
      {highlights.map((h) => <li>{h.text} <span class="hand text-accent">{h.note}</span></li>)}
    </ul>
  </div>
</section>
