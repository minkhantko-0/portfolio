      'M22 50 C21 74, 24 94, 32 102 C50 108, 64 106, 72 100 C79 88, 81 68, 80 50 C60 46, 42 46, 22 50 Z',
      'M80 58 C97 53, 102 76, 82 84',
      'M40 36 C36 28, 44 24, 40 14',
      'M58 38 C54 30, 62 26, 58 16',
    ],
  },
  envelope: {
    viewBox: '0 0 140 100',
    paths: [
      'M13 20 C55 15, 90 15, 127 20 C130 45, 130 65, 127 84 C85 89, 50 89, 15 84 C11 62, 11 41, 13 20 Z',
      'M15 22 C35 42, 55 56, 70 56 C85 56, 107 40, 125 22',
    ],
  },
  plane: {
    viewBox: '0 0 60 48',
    paths: [
      'M4 25 C20 19, 38 12, 54 6 C47 18, 41 30, 34 42 C31 37, 29 33, 26 28 C19 27, 11 26, 4 25 Z',
