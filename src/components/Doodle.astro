---
/**
 * Hand-drawn line-art illustrations. Strokes use .draw-path so the animation
 * island can "draw" them in. `draw` adds data-draw (draw-on-scroll); hero
 * doodles set draw={false} because the hero timeline drives them itself.
 * `float` marks the doodle for the gentle floating loop.
 */
interface Props {
  variant: 'laptop' | 'cloud' | 'database' | 'coffee' | 'envelope' | 'plane' | 'sparkle' | 'gear';
  class?: string;
  draw?: boolean;
  float?: boolean;
  strokeWidth?: number;
}
const { variant, class: className = '', draw = true, float = false, strokeWidth = 3 } = Astro.props;

const doodles: Record<string, { viewBox: string; paths: string[] }> = {
  laptop: {
    viewBox: '0 0 160 120',
    paths: [
      'M24 14 C60 9, 100 9, 136 14 C138 36, 137 58, 134 78 C96 83, 62 83, 26 79 C23 57, 22 36, 24 14 Z',
      'M14 84 C60 80, 102 80, 146 83 C144 89, 141 94, 137 97 C97 101, 63 101, 25 97 C20 93, 17 89, 14 84 Z',
