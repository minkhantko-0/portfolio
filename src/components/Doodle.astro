---
/**
 * Hand-drawn line-art illustrations. Strokes use .draw-path so the animation
 * island can "draw" them in. `draw` adds data-draw (draw-on-scroll); hero
 * doodles set draw={false} because the hero timeline drives them itself.
 * `float` marks the doodle for the gentle floating loop.
 */
interface Props {
  variant:
    | 'envelope'
    | 'plane'
    | 'sparkle'
    | 'gear'
    | 'ball'
    | 'rocket'
    | 'lightbulb'
    | 'gradcap'
    | 'brackets';
  class?: string;
  draw?: boolean;
  float?: boolean;
  strokeWidth?: number;
}
const { variant, class: className = '', draw = true, float = false, strokeWidth = 3 } = Astro.props;

// keyed by the union, not `string` — a variant with no art is now a type error
// here rather than a "Cannot destructure property 'viewBox' of undefined" at
// build time
const doodles: Record<Props['variant'], { viewBox: string; paths: string[] }> = {
  envelope: {
    viewBox: '0 0 140 100',
    paths: [
      'M13 20 C55 15, 90 15, 127 20 C130 45, 130 65, 127 84 C85 89, 50 89, 15 84 C11 62, 11 41, 13 20 Z',
      'M15 22 C35 42, 55 56, 70 56 C85 56, 107 40, 125 22',
    ],
  },
  plane: {
    viewBox: '0 0 60 48',
    paths: [
      'M4 25 C20 19, 38 12, 54 6 C47 18, 41 30, 34 42 C31 37, 29 33, 26 28 C19 27, 11 26, 4 25 Z',
      'M26 28 C35 21, 45 13, 54 6',
    ],
  },
  sparkle: {
    viewBox: '0 0 40 40',
    paths: [
      'M20 3 C22 12, 25 16, 34 20 C25 24, 22 28, 20 37 C18 28, 15 24, 6 20 C15 16, 18 12, 20 3 Z',
    ],
  },
  ball: {
    viewBox: '0 0 40 40',
    paths: [
      'M20 3 C30 3, 37 10, 37 20 C37 30, 30 37, 20 37 C10 37, 3 30, 3 20 C3 10, 10 3, 20 3 Z',
      'M6 13 C14 19, 26 19, 34 13',
      'M6 27 C14 21, 26 21, 34 27',
    ],
  },
  rocket: {
    viewBox: '0 0 100 140',
    paths: [
      'M50 8 C62 24, 68 48, 66 76 C60 84, 40 84, 34 76 C32 48, 38 24, 50 8 Z',
      'M50 32 C56 32, 60 37, 60 42 C60 48, 55 52, 50 52 C45 52, 40 48, 40 42 C40 37, 44 32, 50 32 Z',
      'M34 70 C24 78, 20 92, 22 104 C28 95, 34 90, 37 85',
      'M66 70 C76 78, 80 92, 78 104 C72 95, 66 90, 63 85',
      'M44 92 C46 103, 48 112, 50 122 C52 112, 54 103, 56 92',
    ],
  },
  lightbulb: {
    viewBox: '0 0 90 120',
    paths: [
      'M45 12 C64 12, 75 27, 73 44 C71 57, 62 63, 58 74 C50 76, 40 76, 32 74 C28 63, 19 57, 17 44 C15 27, 26 12, 45 12 Z',
      'M35 85 C42 87, 49 87, 55 85',
      'M37 95 C42 97, 48 97, 53 95',
      'M8 42 C11 42, 14 42, 17 42',
      'M73 42 C76 42, 79 42, 82 42',
      'M45 0 C45 3, 45 5, 45 8',
    ],
  },
  gradcap: {
    viewBox: '0 0 120 90',
    paths: [
      'M60 10 C78 17, 95 25, 112 34 C95 42, 78 50, 60 57 C42 50, 25 42, 8 34 C25 25, 42 17, 60 10 Z',
      'M36 46 C36 60, 44 69, 60 69 C76 69, 84 60, 84 46',
      'M112 34 C112 42, 112 50, 112 57 C112 62, 109 66, 105 68',
    ],
  },
  brackets: {
    viewBox: '0 0 120 80',
    paths: [
      'M42 8 C30 10, 32 25, 26 32 C22 36, 18 38, 15 40 C18 42, 22 44, 26 48 C32 55, 30 68, 42 72',
      'M78 8 C90 10, 88 25, 94 32 C98 36, 102 38, 105 40 C102 42, 98 44, 94 48 C88 55, 90 68, 78 72',
      'M66 14 C61 30, 57 47, 53 66',
    ],
  },
  gear: {
    viewBox: '0 0 90 90',
    paths: [
      'M45 16 C52 16, 55 10, 55 10 C60 12, 65 15, 69 19 C69 19, 65 25, 69 30 C73 35, 80 34, 80 34 C81 39, 81 46, 80 51 C80 51, 73 51, 70 56 C67 61, 70 67, 70 67 C66 71, 61 74, 56 76 C56 76, 52 70, 45 70 C38 70, 34 76, 34 76 C29 74, 24 71, 20 67 C20 67, 24 61, 20 56 C17 51, 10 51, 10 51 C9 46, 9 39, 10 34 C10 34, 17 35, 21 30 C24 25, 21 19, 21 19 C25 15, 30 12, 35 10 C35 10, 38 16, 45 16 Z',
      'M45 34 C52 34, 57 39, 57 45 C57 51, 51 56, 45 56 C39 56, 33 51, 33 45 C33 39, 38 34, 45 34 Z',
    ],
  },
};

const { viewBox, paths } = doodles[variant];
---

<svg
  viewBox={viewBox}
  class={`pointer-events-none ${className}`}
  fill="none"
  aria-hidden="true"
  {...draw ? { 'data-draw': '' } : {}}
  {...float ? { 'data-float': '' } : {}}
>
  {paths.map((d) => <path class="draw-path" d={d} stroke-width={strokeWidth} />)}
</svg>
