      'M98 32 C103 37, 108 42, 112 47 C107 51, 102 56, 98 60',
      'M86 28 C82 39, 78 51, 75 63',
    ],
  },
  cloud: {
    viewBox: '0 0 140 90',
    paths: [
      'M32 66 C14 66, 8 46, 25 40 C22 24, 42 14, 55 24 C60 8, 88 8, 94 24 C112 16, 128 32, 119 48 C132 52, 127 67, 112 66 C86 71, 54 71, 32 66 Z',
      'M46 78 C54 80, 62 80, 70 79',
      'M84 78 C90 79, 96 79, 102 78',
