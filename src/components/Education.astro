---
import { education, languages } from '../data/resume';
import SectionHeading from './SectionHeading.astro';
---

<section class="mx-auto max-w-4xl px-6 py-24" aria-labelledby="education">
  <SectionHeading id="education" label="Education & Languages" aside="where it started" />

  <div data-reveal="up">
    <h3 class="text-lg font-bold">{education.degree}</h3>
    <p class="mt-1 text-sm text-ink-soft">
      {education.school} · {education.period}
    </p>
    <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
      {education.notes.join(' ')}
    </p>
    <p class="mt-4 text-ink-soft">
      <span class="hand text-lg text-ink">Languages:</span> {languages.join(', ')}
    </p>
  </div>
</section>
