---
import { education, languages } from '../data/resume';
import SectionHeading from './SectionHeading.astro';
---

<section class="band" aria-labelledby="education">
  <div class="mx-auto max-w-6xl px-6 py-20 lg:py-24">
  <SectionHeading id="education" label="Education & Languages" aside="where it started" />

  <div class="max-w-3xl">
    <h3 class="text-xl font-bold sm:text-2xl">{education.degree}</h3>
    <p class="mt-1 text-base text-ink-soft">
      {education.school} · {education.period}
    </p>
    <p class="mt-4 text-lg leading-relaxed text-ink">
      {education.notes.join(' ')}
    </p>
    <p class="mt-5 text-lg text-ink">
      <span class="hand text-xl text-accent">Languages:</span> {languages.join(', ')}
    </p>
  </div>
  </div>
</section>
