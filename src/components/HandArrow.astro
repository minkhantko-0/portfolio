---
/**
 * Hand-drawn SVG arrow. Paths use .draw-path and data-draw so the animation
 * island "draws" them (stroke-dashoffset) when scrolled into view.
 */
interface Props {
  variant?: 'down' | 'curve-left' | 'curve-up';
  class?: string;
}
const { variant = 'down', class: className = '' } = Astro.props;

const arrows: Record<NonNullable<Props['variant']>, { viewBox: string; paths: string[] }> = {
  // squiggly arrow pointing down
  down: {
    viewBox: '0 0 40 90',
    paths: [
      'M20 4 C14 16, 27 24, 20 36 C13 48, 26 56, 20 70',
      'M10 60 C13 65, 17 72, 20 78 C23 72, 28 66, 31 61',
    ],
  },
  // sweeping curve that ends pointing left
  'curve-left': {
    viewBox: '0 0 120 70',
    paths: [
      'M114 10 C102 48, 58 62, 14 44',
      'M28 36 C23 39, 17 42, 11 43 C16 48, 21 54, 24 60',
    ],
  },
  // rises from bottom-right, arrowhead pointing up at the top
  'curve-up': {
    viewBox: '0 0 70 90',
    paths: [
      'M62 84 C42 72, 30 52, 32 16',
      'M22 28 C25 20, 28 13, 32 7 C36 13, 40 19, 43 25',
    ],
  },
};

const { viewBox, paths } = arrows[variant];
---

<svg
  viewBox={viewBox}
  class={`pointer-events-none ${className}`}
  fill="none"
  aria-hidden="true"
  data-draw
>
  {paths.map((d) => <path class="draw-path" d={d} stroke-width="2.5" />)}
</svg>
