---
import { profile } from '../data/resume';
import HandArrow from './HandArrow.astro';
import Doodle from './Doodle.astro';
import WorldMap from './WorldMap.astro';
---

<header class="relative mx-auto grid min-h-[92svh] max-w-6xl items-center gap-10 px-6 pb-32 pt-20 lg:grid-cols-[0.85fr_1.15fr]">
  <div class="relative z-10">
    <p class="hand hero-in hero-greeting mb-3 text-2xl text-accent sm:text-3xl">hi, I’m</p>

    <h1 class="hero-in hero-name hand whitespace-nowrap text-[clamp(2.6rem,4.6vw,4rem)] font-bold leading-tight">{profile.name}</h1>
    <!-- hand-drawn double underline, drawn after the letters land -->
    <svg id="hero-underline" viewBox="0 0 420 26" class="mt-1 h-6 w-full max-w-xl text-accent" fill="none" aria-hidden="true">
      <path class="draw-path" stroke-width="3.5" d="M6 10 C80 4, 200 4, 300 8 C350 10, 390 12, 414 14" />
      <path class="draw-path" stroke-width="3" d="M40 20 C130 15, 250 15, 380 20" />
    </svg>

    <p class="hero-in hero-tagline mt-6 max-w-2xl text-lg text-ink-soft sm:text-xl">
      {profile.tagline}. I build products end-to-end —
      <span data-annotate="highlight">and stick around until they work</span>.
    </p>

    <div class="hero-in hero-cta mt-10 flex flex-wrap items-center gap-5">
      <a
        href={profile.cvFile}
        download
        class="inline-flex items-center gap-2 rounded-lg border-2 border-ink bg-ink px-5 py-3 font-semibold text-paper shadow-[4px_4px_0_0_var(--color-accent)] transition-transform duration-150 hover:-translate-y-0.5 hover:shadow-[6px_6px_0_0_var(--color-accent)] active:translate-y-0 active:shadow-[2px_2px_0_0_var(--color-accent)]"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14" />
        </svg>
        Download CV
      </a>
      <a
        href={profile.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub profile"
        title="GitHub"
        class="text-ink transition-all duration-150 hover:-translate-y-1 hover:text-accent"
      >
        <svg class="size-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.34.95.11-.74.4-1.25.73-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.24 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.68 5.38-5.24 5.66.41.36.78 1.05.78 2.13v3.16c0 .3.2.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
        </svg>
      </a>
      <a
        href={profile.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn profile"
        title="LinkedIn"
        class="text-ink transition-all duration-150 hover:-translate-y-1 hover:text-accent"
      >
        <svg class="size-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.55C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.72C24 .77 23.2 0 22.22 0Z" />
        </svg>
      </a>
    </div>

    <div class="hero-in hero-note mt-4 flex items-end gap-1 text-ink-soft">
      <HandArrow variant="curve-up" class="ml-8 h-14 w-11 text-accent" />
      <p class="hand pb-1 text-xl">grab the PDF version</p>
    </div>
  </div>

  <!-- hand-drawn world map: where the work went -->
  <div class="hero-in hero-doodles relative mx-auto hidden w-full lg:block" data-parallax="7" aria-hidden="false">
    <WorldMap />
    <Doodle variant="sparkle" class="twinkle absolute -left-2 top-2 w-6 text-accent" draw={false} strokeWidth={4} />
    <Doodle variant="sparkle" class="twinkle absolute bottom-24 right-2 w-5 text-marker" draw={false} strokeWidth={4} />
    <Doodle variant="plane" class="absolute -top-4 right-16 w-14 text-accent" draw={false} float />
    <!-- hover tooltip for map countries; positioned by animations.ts -->
    <div id="map-tip" class="pointer-events-none invisible absolute left-0 top-0 z-20 rounded-lg border border-line bg-white/95 px-3 py-2 opacity-0 shadow-[3px_4px_12px_rgba(38,34,27,0.15)]">
      <p class="hand text-base font-semibold text-accent" data-tip-country></p>
      <p class="hand text-lg text-ink" data-tip-client></p>
    </div>
  </div>

  <!-- scroll cue -->
  <div class="scroll-cue absolute bottom-6 left-1/2 -translate-x-1/2 text-center">
    <p class="hand text-xl text-ink-soft">scroll down</p>
    <HandArrow variant="down" class="mx-auto h-14 w-7 text-ink-soft" />
  </div>
</header>
