---
import { profile, highlights } from '../data/resume';
import SectionHeading from './SectionHeading.astro';
import Doodle from './Doodle.astro';

const rotations = ['-rotate-2', 'rotate-1', '-rotate-1', 'rotate-2', '-rotate-1'];
---

<section class="relative mx-auto max-w-5xl px-6 py-24" aria-labelledby="about">
  <SectionHeading id="about" label="About" aside="the short version" />

  <div class="flex flex-wrap items-start gap-8">
    <p class="max-w-3xl flex-1 basis-96 text-lg leading-relaxed text-ink-soft" data-reveal="up">
      {profile.summary}
    </p>
    <div data-parallax="16" class="shrink-0 max-sm:hidden">
      <Doodle variant="gear" class="mt-2 w-20 text-ink-soft" float />
    </div>
  </div>

  <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      highlights.map((h, i) => (
        <div data-settle>
          <article
            class={`tape relative border border-line bg-white/70 p-6 shadow-[2px_3px_10px_rgba(38,34,27,0.08)] transition-all duration-200 hover:rotate-0 hover:-translate-y-1.5 hover:shadow-[4px_8px_18px_rgba(38,34,27,0.14)] ${rotations[i % rotations.length]}`}
          >
            <p class="leading-relaxed">{h.text}</p>
            <p class="hand mt-3 text-lg text-accent">— {h.note}</p>
          </article>
        </div>
      ))
    }
  </div>
</section>
