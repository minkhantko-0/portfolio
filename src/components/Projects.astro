---
import { projects } from '../data/resume';
import SectionHeading from './SectionHeading.astro';
import HandArrow from './HandArrow.astro';
---

<section class="mx-auto max-w-5xl px-6 py-24" aria-labelledby="projects">
  <SectionHeading id="projects" label="Projects" aside="shipped, not just started" />

  <div class="grid gap-6 sm:grid-cols-2">
    {
      projects.map((p) => (
        <article
          class={`reveal group relative rounded-xl border-2 bg-white/70 p-6 transition-transform duration-200 hover:-translate-y-1 ${
            p.flagship ? 'border-accent sm:col-span-2' : 'border-line hover:border-ink'
          }`}
        >
          {p.flagship && (
            <div class="pointer-events-none absolute -top-12 right-4 hidden sm:block">
              <p class="hand rotate-3 text-2xl text-accent">{p.note}</p>
              <HandArrow variant="down" class="ml-16 h-10 w-6 text-accent" />
            </div>
          )}
          <h3 class="text-lg font-bold sm:text-xl">
            {p.link ? (
              <a
                href={p.link}
                target="_blank"
                rel="noopener noreferrer"
                class="underline decoration-accent decoration-2 underline-offset-4 hover:text-accent"
              >
                {p.name} ↗
              </a>
            ) : (
              p.name
            )}
          </h3>
          {!p.flagship && p.note && <p class="hand mt-1 text-xl text-accent">{p.note}!</p>}
          <p class="mt-3 leading-relaxed text-ink-soft">{p.description}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {p.tech.map((t) => (
              <li class="rounded-full border border-line bg-paper px-3 py-1 text-xs font-medium text-ink-soft">
                {t}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
