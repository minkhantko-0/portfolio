---
/**
 * A hand-drawn ball that wanders across the whole page in the background —
 * weaving left and right down the viewport as the visitor scrolls
 * (keyframed path scrubbed in animations.ts). Sits behind all content.
 */
import Doodle from './Doodle.astro';
---

<div id="scroll-stage" class="pointer-events-none fixed inset-0 -z-10 hidden overflow-hidden lg:block" aria-hidden="true">
  <div id="scroll-ball" class="absolute left-[4vw] top-[6vh] w-12 opacity-40">
    <Doodle variant="ball" class="w-12 text-accent" draw={false} strokeWidth={3} />
  </div>
</div>
