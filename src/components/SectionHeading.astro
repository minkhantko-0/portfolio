---
interface Props {
  id: string;
  label: string;
  /** small handwritten aside next to the heading */
  aside?: string;
}
const { id, label, aside } = Astro.props;
---

<div class="reveal mb-10 flex flex-wrap items-end gap-x-4 gap-y-1">
  <h2 id={id} class="text-3xl font-bold tracking-tight sm:text-4xl">
    <span data-annotate="underline">{label}</span>
  </h2>
  {aside && <p class="hand text-xl text-ink-soft sm:text-2xl">{aside}</p>}
</div>
