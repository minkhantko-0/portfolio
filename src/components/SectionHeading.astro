---
interface Props {
  id: string;
  label: string;
  /** small handwritten aside next to the heading */
  aside?: string;
}
const { id, label, aside } = Astro.props;
---

<div class="mb-10 flex flex-wrap items-end gap-x-4 gap-y-1" data-reveal="left">
  <h2 id={id} class="hand text-3xl font-bold sm:text-4xl">
    <span data-annotate="underline">{label}</span>
  </h2>
  {aside && <p class="hand text-lg text-ink-soft sm:text-xl">{aside}</p>}
</div>
