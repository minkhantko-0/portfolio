---
import { skills } from '../data/resume';
import SectionHeading from './SectionHeading.astro';
---

<section class="mx-auto max-w-5xl px-6 py-24" aria-labelledby="skills">
  <SectionHeading id="skills" label="Skills" aside="the toolbox" />

  <div class="columns-1 gap-6 sm:columns-2 lg:columns-3">
    {
      skills.map((group) => (
        <div class="reveal mb-6 break-inside-avoid rounded-xl border border-line bg-white/60 p-5">
          <div class="flex items-baseline justify-between gap-2">
            <h3 class="font-bold">{group.group}</h3>
            {group.note && <p class="hand text-lg text-accent">{group.note}</p>}
          </div>
          <ul class="mt-3 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <li class="rounded-full border border-line bg-paper px-3 py-1 text-sm text-ink-soft">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
