---
/**
 * Skills, as a toolbox: a drawn tray with a handle, one compartment per
 * group. A compartment leans toward the hand and its tags rise in turn
 * (tilt.ts, the chips cascade in global.css).
 */
import { skills } from '../data/resume';
import SectionHeading from './SectionHeading.astro';

/** small stroke icons per skill group (24×24, stroke currentColor) */
const icons: Record<string, string> = {
  Languages: '<path d="M9 6 4 12l5 6M15 6l5 6-5 6" stroke-linecap="round" stroke-linejoin="round"/>',
  'Front-End & Mobile':
    '<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 8h18M6 6.2h.01" stroke-linecap="round"/><path d="M9 21h6" stroke-linecap="round"/>',
  'Back-End':
    '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01M11 7.5h2M11 16.5h2" stroke-linecap="round"/>',
  'AI & LLM':
    '<path d="M12 3c1 4 2.5 5.5 6.5 6.5-4 1-5.5 2.5-6.5 6.5-1-4-2.5-5.5-6.5-6.5C9.5 8.5 11 7 12 3Z" stroke-linejoin="round"/><path d="M18.5 15.5c.5 1.8 1.2 2.5 3 3-1.8.5-2.5 1.2-3 3-.5-1.8-1.2-2.5-3-3 1.8-.5 2.5-1.2 3-3Z" stroke-linejoin="round"/>',
  Databases:
    '<ellipse cx="12" cy="5.5" rx="8" ry="2.8"/><path d="M4 5.5v13c0 1.6 3.6 2.9 8 2.9s8-1.3 8-2.9v-13M4 12c0 1.6 3.6 2.9 8 2.9s8-1.3 8-2.9"/>',
  'Cloud & DevOps':
    '<path d="M7 18a4 4 0 0 1-.7-7.94 5.5 5.5 0 0 1 10.66-1.1A4.5 4.5 0 0 1 16.5 18H7Z" stroke-linejoin="round"/>',
  Observability:
    '<path d="M3 17l4.5-6 3.5 4 4-7 6 9" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 21h18" stroke-linecap="round"/>',
  Practices:
    '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 12.5l3 3 5.5-6.5" stroke-linecap="round" stroke-linejoin="round"/>',
};
---

<section class="relative mx-auto max-w-6xl px-6 py-20 lg:py-28" aria-labelledby="skills">
  <SectionHeading id="skills" label="Skills" aside="the toolbox" />

  <div class="toolbox">
    <svg class="toolbox-handle" viewBox="0 0 160 40" aria-hidden="true">
      <path d="M8 40 V22 C8 10, 20 4, 34 4 H126 C140 4, 152 10, 152 22 V40" />
      <path d="M22 40 V24 C22 18, 28 16, 36 16 H124 C132 16, 138 18, 138 24 V40" />
    </svg>
    <span class="toolbox-latch toolbox-latch-l" aria-hidden="true"></span>
    <span class="toolbox-latch toolbox-latch-r" aria-hidden="true"></span>

    <ul class="toolbox-trays" data-enter>
      {
        skills.map((group) => (
          <li class="tray" data-tilt="3" data-lift="4">
            <div class="tray-head">
              <svg class="tray-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" set:html={icons[group.group] ?? icons.Practices} />
              <h3 class="hand tray-title">{group.group}</h3>
            </div>
            {group.note && <p class="hand tray-note">{group.note}</p>}
            <ul class="chips tray-chips">
              {group.items.map((item, i) => (
                <li style={`--i:${i}`}>
                  <span class="chip inline-block rounded-full px-2.5 py-0.5 text-sm text-ink">{item}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
