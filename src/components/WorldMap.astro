---
/**
 * Real-geometry world map (world-atlas 110m TopoJSON + d3-geo), projected and
 * rendered to static SVG at BUILD time — the browser downloads plain markup,
 * no map library ships to the client. A turbulence-displacement filter gives
 * the strokes a scratchy hand-inked look; highlighted countries get a hatch
 * fill. Pins/labels animate via .map-pin/.map-label in the hero timeline;
 * countries fade in with .map-country.
 */
import { geoNaturalEarth1, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
// @ts-ignore - json module
import world110m from 'world-atlas/countries-110m.json';
import { mapMarkers } from '../data/resume';

const W = 800;
const H = 430;

// @ts-ignore - topojson types
const countries = (
  feature(world110m, world110m.objects.countries).features as Array<{
    id: string;
    geometry: object;
  }>
).filter((c) => String(c.id) !== '010'); // skip Antarctica

const projection = geoNaturalEarth1().fitSize([W, H], {
  type: 'FeatureCollection',
  features: countries,
} as never);
const toPath = geoPath(projection);

// trim path precision — halves the inline SVG payload
const round = (d: string) => d.replace(/\d+\.\d+/g, (m) => (+m).toFixed(1));

const clientIds = new Set(mapMarkers.clients.map((c) => c.id));
const homeId = mapMarkers.home.id;

const shapes = countries
  .map((c) => {
    const d = toPath(c as never);
    if (!d) return null;
    const kind = String(c.id) === homeId ? 'home' : clientIds.has(String(c.id)) ? 'client' : 'base';
    return { d: round(d), kind };
  })
  .filter(Boolean) as { d: string; kind: 'home' | 'client' | 'base' }[];

const project = (m: { lon: number; lat: number }) => {
  const [x, y] = projection([m.lon, m.lat]) ?? [0, 0];
  return { x: +x.toFixed(1), y: +y.toFixed(1) };
};

const pins = mapMarkers.clients.map((m) => ({ ...m, ...project(m) }));
const home = { ...mapMarkers.home, ...project(mapMarkers.home) };
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  fill="none"
  class="w-full overflow-visible"
  aria-label="World map of client countries: Myanmar, Japan, Singapore, France, Israel — currently based in Thailand"
  role="img"
>
  <defs>
    <!-- scratchy ink: jitter every stroke with fractal noise -->
    <filter id="scratch" x="-5%" y="-5%" width="110%" height="110%">
      <feTurbulence type="fractalNoise" baseFrequency="0.012" numOctaves="3" seed="7" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="4" />
    </filter>
    <!-- hand-hatched fills -->
    <pattern id="hatch-client" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(-42)">
      <path d="M0 0v6" stroke="#d9480f" stroke-width="1.6" opacity="0.75" />
    </pattern>
    <pattern id="hatch-home" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(38)">
      <path d="M0 0v5" stroke="#e5a50a" stroke-width="2" opacity="0.9" />
    </pattern>
  </defs>

  <g filter="url(#scratch)">
    {
      shapes.map((s) =>
        s.kind === 'base' ? (
          <path class="map-country" d={s.d} fill="#ffffff66" stroke="#5c554a" stroke-opacity="0.55" stroke-width="0.7" />
        ) : (
          <path
            class="map-country"
            d={s.d}
            fill={s.kind === 'home' ? 'url(#hatch-home)' : 'url(#hatch-client)'}
            stroke={s.kind === 'home' ? '#26221b' : '#d9480f'}
            stroke-width="1.4"
          />
        )
      )
    }
  </g>

  <!-- client pins -->
  {
    pins.map((c) => (
      <g class="map-pin">
        <circle class="pin-dot" cx={c.x} cy={c.y} r="6" fill="#d9480f" stroke="#faf8f2" stroke-width="2" />
        <text
          class="map-label hand"
          x={c.x + c.dx}
          y={c.y + c.dy}
          font-size="17"
          fill="#5c554a"
          style="font-family: var(--font-hand)"
        >
          {c.name}
        </text>
      </g>
    ))
  }

  <!-- home base: Thailand -->
  <circle class="pin-home-ring" cx={home.x} cy={home.y} r="11" stroke="#d9a90f" stroke-width="2.5" />
  <g class="map-pin">
    <circle class="pin-dot" cx={home.x} cy={home.y} r="6.5" fill="#ffd43b" stroke="#26221b" stroke-width="2" />
    <text
      class="map-label hand"
      x={home.x + home.dx}
      y={home.y + home.dy}
      font-size="18"
      font-weight="600"
      fill="#26221b"
      style="font-family: var(--font-hand)"
    >
      {home.name} — I’m here!
    </text>
  </g>
</svg>

<p class="map-label hand mt-3 text-center text-lg text-ink-soft">
  <span class="mx-1 inline-block size-3 rounded-full bg-accent align-baseline"></span> clients I’ve shipped for
  <span class="mx-1 ml-5 inline-block size-3 rounded-full border-2 border-ink bg-marker align-baseline"></span> currently based
</p>
