---
import '../styles/global.css';
import { profile } from '../data/resume';
// The @fontsource-variable packages have no per-subset CSS entrypoint (their
// entrypoints split by *axis*), and importing the package root pulls in five
// subsets per family: cyrillic, cyrillic-ext, vietnamese, latin-ext, latin.
// Nothing on this page can match anything outside latin — the only non-ASCII
// glyphs are the ↗ and → arrows, which no bundled subset covers anyway — so
// the two faces are declared by hand against the latin files. That also gives
// us a URL to preload, which the package CSS does not.
import nunitoLatin from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';
import shantellLatin from '@fontsource-variable/shantell-sans/files/shantell-sans-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Min Khant Ko — Software Engineer',
  description = 'Software engineer with 5 years building web and mobile products end-to-end across fintech, healthcare, and SaaS. React, React Native, Node.js, Python, PostgreSQL, and AWS.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

const LATIN_RANGE =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFaces = `
@font-face{font-family:'Nunito Variable';font-style:normal;font-display:swap;font-weight:200 1000;src:url(${nunitoLatin}) format('woff2-variations');unicode-range:${LATIN_RANGE}}
@font-face{font-family:'Shantell Sans Variable';font-style:normal;font-display:swap;font-weight:300 800;src:url(${shantellLatin}) format('woff2-variations');unicode-range:${LATIN_RANGE}}
`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  email: `mailto:${profile.email}`,
  telephone: profile.phone,
  url: Astro.site?.toString(),
  sameAs: [profile.github, profile.linkedin],
  knowsAbout: [
    'React',
    'React Native',
    'Node.js',
    'TypeScript',
    'Python',
    'FastAPI',
    'LangChain',
    'PostgreSQL',
    'MongoDB',
    'AWS',
    'Docker',
    'REST APIs',
    'Cloud Architecture',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Shantell Sans renders .hero-name, the LCP element. Without this the
         request chain is HTML -> CSS -> font; the preload starts it alongside
         the stylesheet instead. The faces are declared inline (rather than in
         global.css) so they are discoverable in the first response too. -->
    <link rel="preload" href={shantellLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // mark JS availability before first paint so .reveal hiding only applies with JS
      document.documentElement.classList.add('js');
      // ...and undo it if the animation bundle never arrives. Without this a
      // failed/blocked module request leaves every [data-reveal] / [data-settle]
      // section at opacity 0 forever. animations.ts clears the timer once it runs.
      window.__revealFallback = setTimeout(function () {
        document.documentElement.classList.remove('js');
      }, 2500);
    </script>
  </head>
  <body class="antialiased">
    <slot />
    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>
