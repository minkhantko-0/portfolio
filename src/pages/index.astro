---
import Base from '../layouts/Base.astro';
import { profile } from '../data/resume';
import Spread from '../components/Spread.astro';
import AboutDeck from '../components/AboutDeck.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
---

<Base>
  <!-- the first spread is a full viewport of name, globe and seven focusable
       pins before any prose -->
  <a href="#content" class="skip-link">Skip to content</a>

  <main>
    <Spread />
    <AboutDeck />
    <Projects />
    <Skills />
    <Education />
    <Contact />
  </main>

  <footer class="mx-auto max-w-6xl px-6 pb-12 pt-12">
    <p class="hand text-center text-lg text-ink-soft">
      hand-drawn with care · © {new Date().getFullYear()} {profile.name}
    </p>
  </footer>
</Base>
